---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Short date: Sep 26, 1986. UTC so local and CI builds render identically.
function formatShortDate(date: Date): string {
  return new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
}

const pubDateIso = article.data.pubDate.toISOString().slice(0, 10);
const updatedIso = (article.data.lastUpdated ?? article.data.pubDate).toISOString().slice(0, 10);
const isUpdated = updatedIso !== pubDateIso;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: pubDateIso,
  ...(isUpdated ? { dateModified: updatedIso } : {}),
  author: { '@type': 'Person', name: article.data.author },
  mainEntityOfPage: `https://compoundvr.com/articles/${article.id}/`,
  ...(article.data.heroImage ? { image: `https://compoundvr.com${article.data.heroImage}` } : {}),
});
---

<Layout title={`${article.data.title} — CompoundVR`} description={article.data.description}>
  <section class="container section">
    <h1>{article.data.title}</h1>
    <p class="lead">{article.data.description}</p>
    {article.data.heroImage && (
      <div class="hero-image-container">
        <img 
          src={article.data.heroImage} 
          alt={article.data.title}
          class="hero-image"
        />
      </div>
    )}
    <div class="meta">{article.data.category} · {pubDateIso} · {article.data.author}{isUpdated && ` · Updated ${updatedIso}`}</div>

    <script type="application/ld+json" set:html={jsonLd}></script>

    <article class="prose" class:list={[{ listicle: article.data.listicle }]} style="margin-top:2rem;">
      <Content />
    </article>

    {article.data.history && article.data.history.length > 0 && (
      <details class="history-log" style="margin-top:1rem;">
        <summary>Article history</summary>
        <div class="history-log-content" style="margin-top:0.75rem;">
          <div>Originally published {formatShortDate(article.data.pubDate)}</div>
          {[...article.data.history]
            .sort((a, b) => +new Date(b.date) - +new Date(a.date))
            .map((h) => (
              <div>{new Date(h.date).toISOString().slice(0, 10)} — {h.note}</div>
            ))}
        </div>
      </details>
    )
  </section>
</Layout>

<style>
  .hero-image-container {
    width: 100%;
    margin-top: 1.5rem;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .history-log {
    border: 1px solid var(--border-default);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    background: var(--surface-secondary);
  }

  .history-log summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-weight: 500;
    list-style: none;
  }

  .history-log summary::-webkit-details-marker {
    display: none;
  }

  .history-log summary::before {
    content: '▸ ';
  }

  .history-log[open] summary::before {
    content: '▾ ';
  }

  .history-log-content {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }

</style>