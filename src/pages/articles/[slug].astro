---
import Layout from '../../layouts/Layout.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Short date: Sep 26, 1986. UTC so local and CI builds render identically.
function formatShortDate(date: Date): string {
  return new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
}

const pubDateIso = article.data.pubDate.toISOString().slice(0, 10);
const updatedIso = (article.data.lastUpdated ?? article.data.pubDate).toISOString().slice(0, 10);
const isUpdated = updatedIso !== pubDateIso;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: pubDateIso,
  ...(isUpdated ? { dateModified: updatedIso } : {}),
  author: { '@type': 'Person', name: article.data.author },
  mainEntityOfPage: `https://compoundvr.com/articles/${article.id}/`,
  ...(article.data.heroImage ? { image: `https://compoundvr.com${article.data.heroImage}` } : {}),
});
---

<Layout title={`${article.data.title} — CompoundVR`} description={article.data.description}>
  <section class="container section">
    <div class="article-content">
    <h1>{article.data.title}</h1>
    <p class="lead">{article.data.description}</p>
    {article.data.heroImage && (
      <div class="hero-image-container">
        <img 
          src={article.data.heroImage} 
          alt={article.data.title}
          class="hero-image"
        />
      </div>
    )}
    <div class="meta">{article.data.category} · {pubDateIso} · {article.data.author}{isUpdated && ` · Updated ${updatedIso}`}</div>

    <script type="application/ld+json" set:html={jsonLd}></script>

    <article class="prose" class:list={[{ listicle: article.data.listicle }]} style="margin-top:2rem;">
      <Content />
    </article>

    {article.data.modDownload && (
      <div class="card mod-download-card" style="margin-top:2rem;">
        <div class="mod-download-header">
          <h3>🎮 Get the Mod</h3>
        </div>
        <p class="mod-download-body">
          <a href={article.data.modDownload.url} class="mod-download-link" target={article.data.modDownload.url.startsWith('http') ? '_blank' : undefined} rel={article.data.modDownload.url.startsWith('http') ? 'noopener noreferrer' : undefined}>
            {article.data.modDownload.label || 'Download the Mod'}
          </a>
          {article.data.modDownload.note && (
            <span class="mod-download-note"> — {article.data.modDownload.note}</span>
          )}
        </p>
      </div>
    )}

    {article.data.faq && article.data.faq.length > 0 && (
      <div class="article-faq" style="margin-top:2rem;">
        <h2>Frequently Asked Questions</h2>
        {article.data.faq.map((item) => (
          <details class="faq-item" style="margin-bottom:1rem;">
            <summary class="faq-question" style="cursor:pointer;font-weight:600;">{item.q}</summary>
            <div class="faq-answer" style="margin-top:0.5rem;padding-left:1rem;">{item.a}</div>
          </details>
        ))}
      </div>
    )}

    <RelatedPages items={article.data.relatedPages} heading="Related articles" />

    {article.data.sources && (
      <div class="article-sources" style="margin-top:2rem;">
        <h2>Sources</h2>
        <div class="sources-content" style="font-size:0.9rem;color:var(--text-tertiary);">{article.data.sources}</div>
      </div>
    )}

    {article.data.history && article.data.history.length > 0 && (
      <details class="history-log" style="margin-top:1rem;">
        <summary>Article history</summary>
        <div class="history-log-content" style="margin-top:0.75rem;">
          <div>Originally published {formatShortDate(article.data.pubDate)}</div>
          {[...article.data.history]
            .sort((a, b) => +new Date(b.date) - +new Date(a.date))
            .map((h) => (
              <div>{new Date(h.date).toISOString().slice(0, 10)} — {h.note}</div>
            ))}
        </div>
      </details>
    )
    </div>
  </section>
</Layout>

<style>
  .hero-image-container {
    width: 100%;
    margin-top: 1.5rem;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .history-log {
    border: 1px solid var(--border-default);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    background: var(--surface-secondary);
  }

  .history-log summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-weight: 500;
    list-style: none;
  }

  .history-log summary::-webkit-details-marker {
    display: none;
  }

  .history-log summary::before {
    content: '▸ ';
  }

  .history-log[open] summary::before {
    content: '▾ ';
  }

  .history-log-content {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }

</style>