---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const pubDateIso = article.data.pubDate.toISOString().slice(0, 10);
const updatedIso = (article.data.lastVerified ?? article.data.pubDate).toISOString().slice(0, 10);
const isUpdated = updatedIso !== pubDateIso;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: pubDateIso,
  ...(isUpdated ? { dateModified: updatedIso } : {}),
  author: { '@type': 'Person', name: article.data.author },
  mainEntityOfPage: `https://compoundvr.com/articles/${article.id}/`,
  ...(article.data.heroImage ? { image: `https://compoundvr.com${article.data.heroImage}` } : {}),
});
---

<Layout title={`${article.data.title} — CompoundVR`} description={article.data.description}>
  <section class="container section">
    <h1>{article.data.title}</h1>
    <p class="lead">{article.data.description}</p>
    {article.data.heroImage && (
      <div class="hero-image-container">
        <img 
          src={article.data.heroImage} 
          alt={article.data.title}
          class="hero-image"
        />
      </div>
    )}
    <div class="meta">{article.data.category} · {pubDateIso} · {article.data.author}{isUpdated && ` · Updated ${updatedIso}`}</div>

    <script type="application/ld+json" set:html={jsonLd}></script>

    <article class="prose" style="margin-top:2rem;">
      <Content />
    </article>
  </section>
</Layout>

<style>
  .hero-image-container {
    width: 100%;
    margin-top: 1.5rem;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

</style>