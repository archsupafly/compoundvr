---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { Content } = await render(game);

// Determine tier class
const tier = game.data.tier || 'B';

// Route type YAML → gamer-friendly display labels
const routeTypeLabels: Record<string, string> = {
  'Official Hybrid': 'Official VR Mode',
  'Official Standalone VR Version': 'Standalone VR',
  'Full VR Mod': 'Full VR Mod',
  'Framework-Based': 'VR Framework',
  'Injection Driver': '3D Injection',
  'Multi-Route Coverage': 'Multiple VR Options',
  'Emulator': 'VR Emulator',
};

// VR addition label: official releases are a "VR release"; everything else is a mod/injection.
const vrAddLabels: Record<string, string> = {
  'Official Hybrid': 'VR release',
  'Official Standalone VR Version': 'VR release',
  'Full VR Mod': 'VR mod',
  'Framework-Based': 'VR mod',
  'Injection Driver': 'VR mod',
  'Multi-Route Coverage': 'VR mod',
  'Emulator': 'VR mod',
};
let tierClass = 'tier tier--large';
if (tier === 'S') tierClass = 'tier tier--large tier--s';
else if (tier === 'A') tierClass = 'tier tier--large tier--a';
else if (tier === 'B') tierClass = 'tier tier--large tier--b';
else if (tier === 'C') tierClass = 'tier tier--large tier--c';
else if (tier === 'D') tierClass = 'tier tier--large tier--d';
else tierClass = 'tier tier--large tier--f';

// Short date: Sep 26, 1986. UTC so local and CI builds render identically.
function formatShortDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
}

// Numeric date: 01/08/2018. UTC so local and CI builds render identically.
function formatNumericDate(date: Date): string {
  const m = String(date.getUTCMonth() + 1).padStart(2, '0');
  const d = String(date.getUTCDate()).padStart(2, '0');
  const y = date.getUTCFullYear();
  return `${m}/${d}/${y}`;
}
---

<Layout title={`${game.data.title} — CompoundVR`} description={game.data.description}>
  <section class="section game-page">
    <div class="game-content">
      <h1>{game.data.title}</h1>
      <p class="lead">{game.data.description}</p>

      {game.data.heroImage && (
        <div class="hero-image-container">
          <img src={game.data.heroImage} alt={game.data.title} class="hero-image" />
        </div>
      )}

      <div class="stats game-stats" style="margin-top:1.5rem;">
        <div class="stat stat-tier">
          <div class="stat-label">Tier</div>
          <div class={tierClass}>{tier}</div>
        </div>
        <div class="stat">
          <div class="stat-label">Platforms</div>
          <div class="stat-value">{game.data.platforms.join(', ')}</div>
        </div>
        <div class="stat">
          <div class="stat-label">VR Option</div>
          <div class="stat-value">{routeTypeLabels[game.data.routeType] || game.data.routeType}</div>
        </div>
        <div class="stat">
          <div class="stat-label">Release</div>
          <div class="stat-value">
            {game.data.flatReleaseDate && formatShortDate(game.data.flatReleaseDate)}
            {game.data.flatReleaseDate && game.data.vrReleaseDate && <><br /><span class="stat-note">{vrAddLabels[game.data.routeType] || 'VR'} {formatNumericDate(game.data.vrReleaseDate)}</span></>}
            {!game.data.flatReleaseDate && game.data.vrReleaseDate && formatShortDate(game.data.vrReleaseDate)}
          </div>
        </div>
        <div class="stat">
          <div class="stat-label">Input</div>
          <div class="stat-value">{game.data.inputStyle}</div>
        </div>
        <div class="stat">
          <div class="stat-label">Setup</div>
          <div class="stat-value">{game.data.setupBurden}</div>
        </div>
        <div class="stat">
          <div class="stat-label">Performance</div>
          <div class="stat-value">{game.data.performance}</div>
        </div>
        <div class="stat">
          <div class="stat-label">Comfort</div>
          <div class="stat-value">{game.data.comfort}</div>
        </div>
      </div>

      <article class="prose article-content" style="margin-top:2rem;">
        <Content />
      </article>

      <div class="card verdict-card" style="margin-top:2rem;">
        <div class="verdict-header">
          <div class="verdict-header-left">
            <h3>Verdict</h3>
            <span class="recommendation-label">{game.data.recommendation}</span>
          </div>
          <div class={tierClass}>{tier}</div>
        </div>
        <p class="lead" style="font-size:1rem;max-width:none;">{game.data.verdict}</p>
      </div>

      {game.data.modDownload && (
        <div class="card mod-download-card" style="margin-top:2rem;">
          <div class="mod-download-header">
            <h3>🎮 Get the Mod</h3>
          </div>
          <p class="mod-download-body">
            <a href={game.data.modDownload.url} class="mod-download-link" target={game.data.modDownload.url.startsWith('http') ? '_blank' : undefined} rel={game.data.modDownload.url.startsWith('http') ? 'noopener noreferrer' : undefined}>
              {game.data.modDownload.label || 'Download the Mod'}
            </a>
            {game.data.modDownload.note && (
              <span class="mod-download-note"> — {game.data.modDownload.note}</span>
            )}
          </p>
        </div>
      )}

      <div class="tags-container" style="margin-top:1.5rem;">
        {[...game.data.genres, ...game.data.technicalTags, ...game.data.experienceTags].map((tag: string) => (
          <span class="pill">{tag}</span>
        ))}
      </div>

      {game.data.sources && (
        <details class="source-log" style="margin-top:1rem;">
          <summary>Sources</summary>
          <div class="source-log-content" style="margin-top:0.75rem;">{game.data.sources}</div>
        </details>
      )}

      <div class="eyebrow" style="margin-top:1.5rem;">Updated {game.data.lastVerified.toISOString().slice(0, 10)}</div>
    </div>
  </section>
</Layout>

<style>

  .game-page {
    padding: 0.5rem 0 4rem;
  }

  .game-content {
    max-width: 80ch;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .game-content h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .hero-image-container {
    width: 100%;
    margin-top: 1.5rem;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .game-stats {
    grid-template-columns: repeat(8, 1fr);
    gap: 0.5rem;
  }

  .game-stats .stat {
    padding: 0.75rem 0.5rem;
  }

  .game-stats .stat-label {
    font-size: 0.6rem;
  }

  .game-stats .stat-value {
    font-size: 0.85rem;
  }

  .stat-tier {
    background: var(--surface-secondary);
    border-color: var(--border-default);
  }

  .verdict-card {
    border: 1px solid var(--border-default);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    background: var(--surface-secondary);
  }

  .verdict-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .verdict-header h3 {
    margin: 0;
    color: var(--text-primary);
  }

  .verdict-header-left {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .recommendation-label {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-weight: 400;
  }

  .stat-note {
    color: var(--text-tertiary);
    font-size: 0.75rem;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .mod-download-card {
    border: 1px solid var(--border-default);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    background: var(--surface-secondary);
  }

  .mod-download-header h3 {
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
  }

  .mod-download-body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  .mod-download-link {
    color: var(--text-link, #4f9cf7);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
  }

  .mod-download-link:hover {
    opacity: 0.85;
  }

  .mod-download-note {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .source-log {
    border: 1px solid var(--border-default);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    background: var(--surface-secondary);
  }

  .source-log summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-weight: 500;
    list-style: none;
  }

  .source-log summary::-webkit-details-marker {
    display: none;
  }

  .source-log summary::before {
    content: '▸ ';
  }

  .source-log[open] summary::before {
    content: '▾ ';
  }

  .source-log-content {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .game-content {
      padding: 0 0.5rem;
    }

    .game-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>