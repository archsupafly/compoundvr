---
import Layout from '../../layouts/Layout.astro';
import CardGrid from '../../components/CardGrid.astro';
import { getCollection } from 'astro:content';

// Sort by tier (S > A > B > C > D > F) for ranking visibility,
// tiebreak by recency (lastVerified newest first).
const tierOrder = { 'S': 0, 'A': 1, 'B': 2, 'C': 3, 'D': 4, 'F': 5 };
const tierRank = (t?: string) => tierOrder[t as keyof typeof tierOrder] ?? 2;
const validDate = (d?: Date) => (d && !isNaN(d.valueOf()) ? d : undefined);
const epoch = (d?: Date) => validDate(d)?.valueOf() ?? 0;
// Release = flat date, falling back to VR date when flat is missing/invalid
// (5 VR-native titles carry flatReleaseDate: "null", which coerces Invalid).
const releaseOf = (g: any) => validDate(g.data.flatReleaseDate) ?? validDate(g.data.vrReleaseDate);
const allGames = await getCollection('games');
const relYears = allGames.map((g) => releaseOf(g)?.getUTCFullYear()).filter((y): y is number => y !== undefined);
const minYear = Math.min(...relYears);
const maxYear = Math.max(...relYears);
const games = allGames.sort((a, b) => {
  const dt = tierRank(a.data.tier) - tierRank(b.data.tier);
  if (dt !== 0) return dt;
  return epoch(b.data.lastVerified) - epoch(a.data.lastVerified);
});
---

<Layout title="Games — CompoundVR" description="Canonical game pages and verdicts for playing flat games in VR.">
  <section class="container">
    <div class="eyebrow">Canonical game pages</div>
    <h1>Verdicts that tell you whether a game is worth playing in VR.</h1>
    <p class="lead">Each page is built to answer whether playing in VR is viable, what the setup burden is, and who should actually bother.</p>
  </section>
  <section class="section container">
    <div class="games-toolbar games-toolbar--sort">
      <label class="games-sort-label" for="games-sort">Sort by</label>
      <select id="games-sort" class="games-sort-select">
        <option value="tier-desc" selected>Tier: Best first</option>
        <option value="tier-asc">Tier: Worst first</option>
        <option value="updated">Recently updated</option>
        <option value="released-desc">Game release: Newest</option>
        <option value="released-asc">Game release: Oldest</option>
        <option value="title-asc">Title A–Z</option>
        <option value="title-desc">Title Z–A</option>
      </select>
      <button type="button" id="games-filter-toggle" class="games-filter-toggle" aria-expanded="false" aria-controls="games-filters-box">Show filters</button>
      <span class="games-count" id="games-count"></span>
    </div>
    <div class="games-toolbar games-toolbar--filters" id="games-filters-box" hidden>
      <label class="games-sort-label" for="games-path">VR path</label>
      <select id="games-path" class="games-sort-select">
        <option value="any" selected>All paths</option>
        <option value="Native VR">Native VR</option>
        <option value="Official Hybrid">Official VR mode</option>
        <option value="Full VR Mod">Full VR mod</option>
        <option value="Framework Only">VR framework / injector</option>
        <option value="Multi-Route Coverage">Multiple VR options</option>
      </select>
      <label class="games-sort-label" for="games-perf">PC load</label>
      <select id="games-perf" class="games-sort-select">
        <option value="any" selected>Any PC</option>
        <option value="Efficient">Efficient (potato)</option>
        <option value="Moderate Demand">Moderate demand</option>
        <option value="Heavy Demand">Heavy demand</option>
        <option value="Inconsistent / Unpredictable">Inconsistent</option>
      </select>
      <label class="games-sort-label" for="games-genre">Genre</label>
      <select id="games-genre" class="games-sort-select">
        <option value="any" selected>All genres</option>
        <option>Action</option>
        <option>Adventure</option>
        <option>Action-Adventure</option>
        <option>First-Person Shooter</option>
        <option>FPS</option>
        <option>Action RPG</option>
        <option>RPG</option>
        <option>Horror</option>
        <option>Survival Horror</option>
        <option>Puzzle</option>
        <option>Platformer</option>
        <option>Racing</option>
        <option>Sports</option>
        <option>Open World</option>
        <option>Simulation</option>
      </select>
      <label class="games-sort-label" for="games-tech">Tech</label>
      <select id="games-tech" class="games-sort-select">
        <option value="any" selected>Any tech</option>
        <option value="uevr">UEVR</option>
        <option value="vorpx">VorpX</option>
        <option value="emulator">Emulator</option>
        <option value="motion">Motion controls</option>
        <option value="lukeross">Luke Ross mod</option>
      </select>
      <label class="games-sort-label" for="games-platform">Platform</label>
      <select id="games-platform" class="games-sort-select">
        <option value="any" selected>All platforms</option>
        <option>PCVR</option>
        <option>Quest</option>
        <option>PSVR</option>
        <option>PSVR2</option>
        <option>Pico</option>
      </select>
      <div class="games-tiers" id="games-tiers" role="group" aria-label="Filter by tier">
        <span class="games-sort-label">Tier</span>
        {['S', 'A', 'B', 'C', 'D', 'F'].map((t) => (
          <button type="button" class={`tier-chip tier--${t.toLowerCase()}`} data-tier={t} aria-pressed="true">{t}</button>
        ))}
      </div>
      <span class="games-year" id="games-year" role="group" aria-label="Filter by release year">
        <span class="games-sort-label">Year</span>
        <input type="number" id="games-year-from" class="games-year-input" min={minYear} max={maxYear} placeholder={String(minYear)} aria-label="Released from year" />
        <span class="games-year-sep">–</span>
        <input type="number" id="games-year-to" class="games-year-input" min={minYear} max={maxYear} placeholder={String(maxYear)} aria-label="Released to year" />
      </span>
      <button type="button" id="games-reset" class="games-reset" hidden>Reset</button>
    </div>
    <CardGrid items={games.map((game) => ({
      href: `/games/${game.id}/`,
      title: game.data.title,
      description: game.data.verdict,
      heroImage: game.data.heroImage,
      tier: game.data.tier,
      routeType: game.data.routeType,
      platforms: game.data.platforms,
      recommendation: game.data.recommendation,
      setupBurden: game.data.setupBurden,
      sortTier: tierRank(game.data.tier),
      sortUpdated: epoch(game.data.lastVerified),
      sortReleased: epoch(releaseOf(game)),
      filterRoute: game.data.routeType,
      filterPerf: game.data.performance,
      filterGenres: (game.data.genres || []).join('|'),
      filterTech: (game.data.technicalTags || []).join('|'),
    }))} columns={3} />
  </section>
</Layout>

<style>
  .games-toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .games-sort-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary, #6b7280);
  }
  .games-sort-select {
    font-size: 0.9rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--border-default, rgba(0, 0, 0, 0.12));
    background: var(--surface-primary, #ffffff);
    color: var(--text-primary, #0b1020);
    cursor: pointer;
  }
  .games-count {
    font-size: 0.85rem;
    color: var(--text-tertiary, #8b92b8);
    margin-left: auto;
  }
  .games-tiers {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .tier-chip {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.8rem;
    font-weight: 700;
    width: 2rem;
    height: 2rem;
    border-radius: 6px;
    cursor: pointer;
    background: var(--surface-primary, #ffffff);
    border: 1px solid var(--border-default, rgba(0, 0, 0, 0.12));
    color: var(--text-tertiary, #8b92b8);
    opacity: 0.45;
    transition: opacity 0.15s ease;
  }
  .tier-chip[aria-pressed="true"] {
    opacity: 1;
  }
  .tier-chip.tier--s[aria-pressed="true"] { color: #f0c674; border-color: rgba(240, 198, 116, 0.4); }
  .tier-chip.tier--a[aria-pressed="true"] { color: #22c55e; border-color: rgba(34, 197, 94, 0.4); }
  .tier-chip.tier--b[aria-pressed="true"] { color: #0891b2; border-color: rgba(110, 231, 255, 0.4); }
  .tier-chip.tier--c[aria-pressed="true"] { color: #f59e0b; border-color: rgba(245, 158, 11, 0.4); }
  .tier-chip.tier--d[aria-pressed="true"] { color: #f97316; border-color: rgba(249, 115, 22, 0.4); }
  .tier-chip.tier--f[aria-pressed="true"] { color: #ef4444; border-color: rgba(239, 68, 68, 0.4); }
  .games-filter-toggle {
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--border-default, rgba(0, 0, 0, 0.12));
    background: var(--surface-primary, #ffffff);
    color: var(--text-primary, #0b1020);
    cursor: pointer;
  }
  .games-filter-toggle:hover {
    border-color: var(--accent-cyan, #6ee7ff);
  }
  .games-toolbar--filters[hidden] {
    display: none;
  }
  .games-toolbar--filters {
    border: 1px solid var(--border-default, rgba(0, 0, 0, 0.12));
    background: var(--surface-secondary, rgba(0, 0, 0, 0.02));
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }
  .games-year {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .games-year-input {
    font-size: 0.9rem;
    width: 4.5rem;
    padding: 0.5rem 0.5rem;
    border-radius: 8px;
    border: 1px solid var(--border-default, rgba(0, 0, 0, 0.12));
    background: var(--surface-primary, #ffffff);
    color: var(--text-primary, #0b1020);
  }
  .games-year-sep {
    color: var(--text-tertiary, #8b92b8);
  }
  .games-reset {
    font-size: 0.85rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--border-default, rgba(0, 0, 0, 0.12));
    background: transparent;
    color: var(--text-secondary, #6b7280);
    cursor: pointer;
  }
</style>

<script>
  (function () {
    var select = document.getElementById('games-sort');
    var count = document.getElementById('games-count');
    var grid = select ? select.closest('section').querySelector('.game-grid') : null;
    if (!select || !grid) return;
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.game-card'));
    // Only cards carrying sort keys participate (homepage grid has none).
    cards = cards.filter(function (c) { return c.hasAttribute('data-sort-tier'); });
    function num(c, k) { return parseInt(c.getAttribute(k) || '0', 10); }
    function str(c, k) { return c.getAttribute(k) || ''; }
    var comparators = {
      'tier-desc': function (a, b) { return num(a, 'data-sort-tier') - num(b, 'data-sort-tier') || num(b, 'data-sort-updated') - num(a, 'data-sort-updated'); },
      'tier-asc': function (a, b) { return num(b, 'data-sort-tier') - num(a, 'data-sort-tier') || num(b, 'data-sort-updated') - num(a, 'data-sort-updated'); },
      'updated': function (a, b) { return num(b, 'data-sort-updated') - num(a, 'data-sort-updated'); },
      'released-desc': function (a, b) { return num(b, 'data-sort-released') - num(a, 'data-sort-released'); },
      'released-asc': function (a, b) { return num(a, 'data-sort-released') - num(b, 'data-sort-released'); },
      'title-asc': function (a, b) { return str(a, 'data-sort-title') < str(b, 'data-sort-title') ? -1 : 1; },
      'title-desc': function (a, b) { return str(a, 'data-sort-title') > str(b, 'data-sort-title') ? -1 : 1; },
    };
    var pathSel = document.getElementById('games-path');
    var perfSel = document.getElementById('games-perf');
    var genreSel = document.getElementById('games-genre');
    var techSel = document.getElementById('games-tech');
    var platSel = document.getElementById('games-platform');
    var tiersBox = document.getElementById('games-tiers');
    var resetBtn = document.getElementById('games-reset');
    var yearFrom = document.getElementById('games-year-from');
    var yearTo = document.getElementById('games-year-to');
    function yearOf(c) {
      var ts = num(c, 'data-sort-released');
      if (!ts) return NaN;
      return new Date(ts).getUTCFullYear();
    }
    function yearActive() {
      var f = yearFrom && yearFrom.value !== '';
      var t = yearTo && yearTo.value !== '';
      return f || t;
    }
    var filterToggle = document.getElementById('games-filter-toggle');
    var filtersBox = document.getElementById('games-filters-box');
    var activeTiers = { 'S': true, 'A': true, 'B': true, 'C': true, 'D': true, 'F': true };
    var RANK_TIER = ['S', 'A', 'B', 'C', 'D', 'F'];
    function tags(c, k) { return (c.getAttribute(k) || '').split('|'); }
    function techMatch(list, key) {
      var low = list.map(function (t) { return t.toLowerCase(); });
      var has = function (s) { return low.indexOf(s) !== -1; };
      var any = function (re) { return low.some(function (t) { return re.test(t); }); };
      if (key === 'uevr') return has('uevr') || has('uevr compatible');
      if (key === 'vorpx') return any(/vorpx/) || has('directvr') || has('direct vr');
      if (key === 'emulator') return any(/emulat/) || any(/dolphin/) || any(/ppsspp/) || any(/3dsen/) || any(/retroarch/) || any(/citra/) || any(/dolphin vr/);
      if (key === 'motion') return has('motion controls') || has('motion controllers') || has('motion controller support');
      if (key === 'lukeross') return any(/luke ross/);
      return false;
    }
    function visible(c) {
      var tier = RANK_TIER[num(c, 'data-sort-tier')] || '';
      if (!activeTiers[tier]) return false;
      if (pathSel && pathSel.value !== 'any' && c.getAttribute('data-route') !== pathSel.value) return false;
      if (perfSel && perfSel.value !== 'any' && c.getAttribute('data-perf') !== perfSel.value) return false;
      if (genreSel && genreSel.value !== 'any' && tags(c, 'data-genres').indexOf(genreSel.value) === -1) return false;
      if (techSel && techSel.value !== 'any' && !techMatch(tags(c, 'data-tech'), techSel.value)) return false;
      if (platSel && platSel.value !== 'any' && tags(c, 'data-platforms').indexOf(platSel.value) === -1) return false;
      if (yearActive()) {
        var y = yearOf(c);
        var f = yearFrom ? parseInt(yearFrom.value, 10) : NaN;
        var t = yearTo ? parseInt(yearTo.value, 10) : NaN;
        if (isNaN(y)) return false;
        if (!isNaN(f) && y < f) return false;
        if (!isNaN(t) && y > t) return false;
      }
      return true;
    }
    function activeFilterCount() {
      var n = 0;
      var allTiers = ['S', 'A', 'B', 'C', 'D', 'F'].every(function (t) { return activeTiers[t]; });
      if (!allTiers) n++;
      [pathSel, perfSel, genreSel, techSel, platSel].forEach(function (s) {
        if (s && s.value !== 'any') n++;
      });
      if (yearActive()) n++;
      return n;
    }
    function isDefault() {
      var sels = [pathSel, perfSel, genreSel, techSel, platSel];
      var allTiers = ['S', 'A', 'B', 'C', 'D', 'F'].every(function (t) { return activeTiers[t]; });
      var yearsClear = !yearFrom || yearFrom.value === '';
      yearsClear = yearsClear && (!yearTo || yearTo.value === '');
      return allTiers && sels.every(function (s) { return !s || s.value === 'any'; }) && yearsClear && select.value === 'tier-desc';
    }
    function renderToggle() {
      if (!filterToggle) return;
      var open = filtersBox && !filtersBox.hidden;
      var n = activeFilterCount();
      filterToggle.textContent = (open ? 'Hide filters' : 'Show filters') + (n > 0 ? ' (' + n + ')' : '');
      filterToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    function apply() {
      var cmp = comparators[select.value] || comparators['tier-desc'];
      var shown = 0;
      cards.slice().sort(cmp).forEach(function (c) {
        if (visible(c)) { c.style.display = ''; grid.appendChild(c); shown++; }
        else { c.style.display = 'none'; }
      });
      if (count) count.textContent = shown + ' of ' + cards.length + ' games';
      if (resetBtn) resetBtn.hidden = isDefault();
      renderToggle();
    }
    select.addEventListener('change', apply);
    [pathSel, perfSel, genreSel, techSel, platSel].forEach(function (s) {
      if (s) s.addEventListener('change', apply);
    });
    [yearFrom, yearTo].forEach(function (s) {
      if (s) s.addEventListener('input', apply);
    });
    if (tiersBox) tiersBox.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('[data-tier]') : null;
      if (!btn) return;
      var t = btn.getAttribute('data-tier');
      activeTiers[t] = !activeTiers[t];
      btn.setAttribute('aria-pressed', activeTiers[t] ? 'true' : 'false');
      apply();
    });
    if (filterToggle && filtersBox) filterToggle.addEventListener('click', function () {
      filtersBox.hidden = !filtersBox.hidden;
      renderToggle();
    });
    if (resetBtn) resetBtn.addEventListener('click', function () {
      Object.keys(activeTiers).forEach(function (t) { activeTiers[t] = true; });
      if (tiersBox) tiersBox.querySelectorAll('[data-tier]').forEach(function (b) { b.setAttribute('aria-pressed', 'true'); });
      [pathSel, perfSel, genreSel, techSel, platSel].forEach(function (s) {
        if (s) s.value = 'any';
      });
      if (yearFrom) yearFrom.value = '';
      if (yearTo) yearTo.value = '';
      select.value = 'tier-desc';
      apply();
    });
    apply();
  })();
</script>
