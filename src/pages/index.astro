---
import Layout from '../layouts/Layout.astro';
import CardGrid from '../components/CardGrid.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import FeaturedHero from '../components/FeaturedHero.astro';
import { getCollection } from 'astro:content';

// Sort games by last verified date (newest first) for freshness
const allGames = (await getCollection('games')).sort((a, b) => {
  const dateA = a.data.lastVerified?.valueOf() || 0;
  const dateB = b.data.lastVerified?.valueOf() || 0;
  return dateB - dateA;
});

// Games for the 2-column grid (up to 10)
const displayGames = allGames.slice(0, 10);

// Homepage coverage counters (mutually exclusive game buckets sum to total)
const nativeCount = allGames.filter((g) => g.data.routeType === 'Native VR').length;
const hybridCount = allGames.filter((g) => g.data.routeType === 'Official Hybrid').length;
const moddedCount = allGames.filter((g) =>
  ['Full VR Mod', 'Framework Only', 'Multi-Route Coverage'].includes(g.data.routeType)
).length;

// Articles for the sidebar column (up to 10, exclude featured ones already in carousel)
const featuredSlugs = ['flatout-4-vr', 'microsoft-flight-simulator', 'dolphin-vr', 'triangle-strategy', 'outward'];
const allArticles = (await getCollection('articles')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const sidebarArticles = allArticles
  .filter(a => !featuredSlugs.includes(a.id))
  .slice(0, 10);

// Featured items: games + articles in editorial order
const gamesMap = Object.fromEntries(allGames.map(g => [g.id, g]));
const articlesMap = Object.fromEntries(allArticles.map(a => [a.id, a]));

const featuredItems = featuredSlugs
  .map(slug => {
    const game = gamesMap[slug];
    if (game) {
      return {
        href: `/games/${game.id}/`,
        title: game.data.title,
        description: game.data.verdict,
        heroImage: game.data.heroImage,
        category: 'game',
        date: game.data.lastVerified || game.data.flatReleaseDate || new Date(),
      };
    }
    const article = articlesMap[slug];
    if (article) {
      return {
        href: `/articles/${article.id}/`,
        title: article.data.title,
        description: article.data.description,
        heroImage: article.data.heroImage,
        category: article.data.category,
        date: article.data.pubDate,
      };
    }
    return null;
  })
  .filter(Boolean);
---

<Layout title="CompoundVR — Flat-to-VR intelligence" description="CompoundVR catalogs, reviews, and evaluates flat-to-VR games and mods.">
  <section class="hero homepage-hero container">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>Your guide to the best mods, hybrid, and native VR games</h1>
        <p class="lead">
          CompoundVR is a decision database with editorial judgment layered on top — canonical game pages,
          setup reality checks, and trustworthy verdicts on whether playing in VR is actually worth your time.
        </p>
        <div class="hero-buttons">
          <a class="hero-btn hero-btn--primary" href="/games/">Browse all games</a>
          <a class="hero-btn hero-btn--secondary" href="/articles/">View articles</a>
        </div>
      </div>
      <dl class="hero-stats" aria-label="Site coverage statistics">
        <div class="hero-stats__total">
          <dd>{allGames.length}</dd>
          <dt>Games covered</dt>
        </div>
        <div class="hero-stats__row">
          <div><dd>{nativeCount}</dd><dt>Native VR</dt></div>
          <div><dd>{hybridCount}</dd><dt>Official hybrid</dt></div>
          <div><dd>{moddedCount}</dd><dt>VR modded</dt></div>
          <div><dd>{allArticles.length}</dd><dt>Guides &amp; articles</dt></div>
        </div>
      </dl>
    </div>
  </section>

  {featuredItems.length > 0 && (
    <section class="section homepage-featured container">
      <FeaturedHero items={featuredItems} />
    </section>
  )}

  <section class="section container">
    <div class="home-grid">
      <div class="home-grid__col">
        <h2>Games</h2>
        <div class="home-grid__games">
          <CardGrid items={displayGames.map((game) => ({
            href: `/games/${game.id}/`,
            title: game.data.title,
            description: game.data.verdict,
            heroImage: game.data.heroImage,
            tier: game.data.tier,
            routeType: game.data.routeType,
            platforms: game.data.platforms,
            recommendation: game.data.recommendation,
            setupBurden: game.data.setupBurden,
          }))} columns={2} />
        </div>
        <a class="see-more" href="/games/">See more games →</a>
      </div>
      <div class="home-grid__col">
        <h2>Articles</h2>
        <div class="home-grid__articles">
          <ArticleGrid items={sidebarArticles.map((article) => ({
            href: `/articles/${article.id}/`,
            title: article.data.title,
            description: article.data.description,
            heroImage: article.data.heroImage,
            meta: `${article.data.category} · ${article.data.pubDate.toISOString().slice(0, 10)}`,
          }))} columns={1} layout="horizontal" />
        </div>
        <a class="see-more" href="/articles/">See more articles →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .homepage-hero {
    padding: 0.5rem 0 0.5rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .hero-copy {
    text-align: left;
  }
  .homepage-hero h1 {
    margin-bottom: 0.75rem;
  }
  .homepage-hero .lead {
    margin-left: 0;
    margin-right: 0;
    max-width: 640px;
  }
  .hero-buttons {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .hero-btn {
    display: inline-block;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    transition: filter 0.15s ease;
  }
  .hero-btn:hover {
    filter: brightness(1.08);
  }
  .hero-btn--primary {
    background: #0891b2;
    color: #ffffff;
  }
  .hero-btn--secondary {
    background: var(--surface-primary, #ffffff);
    color: var(--text-primary, #0b1020);
    border: 1px solid var(--border-default, rgba(0, 0, 0, 0.12));
  }
  .hero-stats {
    margin: 0;
    text-align: center;
    background: var(--surface-secondary, rgba(0, 0, 0, 0.02));
    border: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.08));
    border-radius: 12px;
    padding: 1.5rem;
  }
  .hero-stats__total dd {
    font-size: 2.75rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary, #0b1020);
    line-height: 1;
  }
  .hero-stats__total dt {
    font-size: 0.85rem;
    color: var(--text-secondary, #6b7280);
    margin-top: 0.25rem;
  }
  .hero-stats__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.08));
  }
  .hero-stats__row dd {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary, #0b1020);
  }
  .hero-stats__row dt {
    font-size: 0.7rem;
    color: var(--text-tertiary, #8b92b8);
    margin-top: 0.15rem;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      text-align: center;
    }
    .homepage-hero .lead {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-buttons {
      justify-content: center;
    }
  }
  .homepage-featured {
    padding: 0 0 2rem;
  }

  .home-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .home-grid h2 {
    margin: 0 0 1rem;
  }
  .home-grid__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .see-more {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--accent-cyan, #0891b2);
    text-decoration: none;
  }
  .see-more:hover {
    text-decoration: underline;
  }



  @media (max-width: 900px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .homepage-hero {
      padding: 1rem 0 0.25rem;
    }
  }
</style>